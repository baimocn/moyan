# 墨衍 · 生产环境变量示例（复制为 .env，填真值后部署）
# 真实 .env 已 gitignore，绝不入库

# ---- AI 引擎（OpenAI 兼容协议）----
MOYAN_AI_MAIN_BASE_URL=https://opencode.ai/zen/go/v1
MOYAN_AI_MAIN_KEY=sk-REPLACE_ME
MOYAN_AI_MAIN_MODEL=deepseek-v4-flash

MOYAN_AI_CHEAP_BASE_URL=https://opencode.ai/zen/go/v1
MOYAN_AI_CHEAP_KEY=sk-REPLACE_ME
MOYAN_AI_CHEAP_MODEL=deepseek-v4-flash

# ---- 数据库（生产推荐 PostgreSQL）----
# MOYAN_DB_URL=postgresql+psycopg2://moyan:STRONG_PASSWORD@127.0.0.1:5432/moyan

# ---- 服务监听（由 systemd / 启动脚本管理）----
MOYAN_HOST=127.0.0.1
MOYAN_PORT=5001

# ---- CORS（生产域名；Caddy 反代同源时留空）----
# MOYAN_CORS_ORIGINS=https://moyan.example.com

# ---- 鉴权（生产必填）----
MOYAN_WX_APPID=wxxxxxxxxxxxxxxxxx
MOYAN_WX_APPSECRET=REPLACE_ME
MOYAN_JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM  # python -c "import secrets;print(secrets.token_urlsafe(48))"
MOYAN_AUTH_DISABLED=0
